# Set these in Vercel Environment Variables, Production scope.
# The Supabase integration's NEXT_PUBLIC_SUPABASE_URL is also supported.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# If using the legacy key instead, set SUPABASE_SERVICE_ROLE_KEY.
COMMENTS_SITE_URL=https://arnut.vercel.app
# Preview scope: use the exact stable Vercel branch URL instead.
